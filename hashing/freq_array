#include <iostream>
using namespace std;
int main() {
    int n;
    cin>> n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>> arr[i];
    }
    //precompute
    int hash[13]={0};
    for(int i=0;i<n;i++){
        hash[arr[i]]+=1;
    }
    int q;
    cin>> q;
    while(q--){
        int number;
        cin >> number;
        cout<< hash[number]<< endl;

    }
    return 0;
}

Java:
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++) arr[i]=sc.nextInt();
        //precompute
        int[] hash=new int[13];
        for(int i=0;i<n;i++){
            hash[arr[i]]+=1;
        }
        int q=sc.nextInt();
        while(q-->0){
            int number=sc.nextInt();
            System.out.println(hash[number]);
        }
    }
}
