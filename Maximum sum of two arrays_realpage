Problem Statement
Given two sorted arrays, you can start from either array.
Move from left to right.
At common elements (intersection points), you are allowed to switch from one array to the other.
Find the maximum possible sum.
Example
Array1 = [2, 3, 7, 10, 12]
Array2 = [1, 5, 7, 8]
Output = 35
Path:
1 + 5 = 6
Switch at 7
7 + 10 + 12 = 29
Total = 35
Code:
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n= sc.nextInt();
        int[] arr1= new int[n];
        for(int i=0;i<n;i++) arr1[i]=sc.nextInt();
        int m=sc.nextInt();
        int[] arr2= new  int[m];
        for(int i=0;i<m;i++) arr2[i]=sc.nextInt();
        long result= getMaxsum(arr1,arr2,n,m);
        System.out.println("Max sum of arrays is "+result);
    }
    private static long getMaxsum(int[] arr1, int[] arr2, int n, int m){
        long sum1=0,sum2=0,res=0;
        int i=0, j=0;
        while(i<n && j<m){
            if(arr1[i]< arr2[j]){
                sum1+=arr1[i++];
            }
            else if(arr1[i] > arr2[j]){
                sum2+=arr2[j++];
            }else{
                res+=Math.max(sum1,sum2)+arr1[i];
                sum1=0;
                sum2=0;
                i++;
                j++;
            }
        }
        while(i<n){
            sum1+=arr1[i++];
        }
        while(j<m){
            sum2+=arr2[j++];
        }
        res+=Math.max(sum1,sum2);
        return res;
    }
}
